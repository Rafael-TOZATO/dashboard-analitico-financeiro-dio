:root { --background: oklch(97.5% .008 265); --foreground: oklch(20.5% .035 263); --card: oklch(100% 0 0); --primary: oklch(51.7% .086 181); --primary-foreground: oklch(97.5% .008 265); --secondary: oklch(95.4% .009 265); --muted: oklch(95.4% .009 265); --muted-foreground: oklch(55.7% .033 265); --accent: oklch(95% .028 181); --border: oklch(91.8% .016 265); --warn: oklch(52.8% .143 39); --blue: oklch(60% .13 249); --gold: oklch(74% .13 85); --teal: oklch(71% .09 181); --shadow-soft: 0 4px 24px oklch(20% .03 265 / .035); }

.app-header { z-index: 40; background: var(--card); position: sticky; top: 0px; }

@supports (color: color-mix(in lab, red, red)) {
  .app-header { background: color-mix(in oklab,var(--card) 78%,transparent); }
}

.app-header { backdrop-filter: blur(24px); border-bottom: 1px solid var(--border); }

.header-inner, .workspace, .footer-inner { max-width: 1200px; margin: 0px auto; padding-left: 32px; padding-right: 32px; }

.header-top { justify-content: space-between; align-items: center; gap: 16px; height: 78px; display: flex; }

.brand-mark { background: var(--primary); width: 38px; height: 38px; color: var(--primary-foreground); border-radius: 10px; place-items: center; display: grid; }

.nav { scrollbar-width: none; gap: 6px; padding-bottom: 14px; display: flex; overflow-x: auto; }

.nav-link { white-space: nowrap; color: var(--muted-foreground); border-radius: 999px; align-items: center; gap: 8px; padding: 9px 15px; font-size: 13px; transition: background 0.2s; display: flex; }

.nav-link:hover { background: var(--secondary); }

.nav-link.active { background: var(--primary); color: var(--primary-foreground); }

.workspace { padding-top: 30px; padding-bottom: 32px; }

.page-heading { justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 22px; display: flex; }

.page-heading h1 { font-size: 28px; font-weight: 600; line-height: 1.25; }

.page-heading p { color: var(--muted-foreground); margin-top: 6px; font-size: 13px; }

.filters { flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 20px; display: flex; }

.filter-select { border: 1px solid var(--border); background: var(--card); border-radius: 10px; height: 38px; }

@supports (color: color-mix(in lab, red, red)) {
  .filter-select { background: color-mix(in oklab,var(--card) 80%,transparent); }
}

.filter-select { min-width: 125px; color: var(--foreground); padding: 0px 30px 0px 12px; font-size: 12px; }

.filter-select:focus { outline: 2px solid var(--primary); outline-offset: 2px; }

.glass-panel { border: 1px solid var(--border); background: var(--card); border-radius: 18px; }

@supports (color: color-mix(in lab, red, red)) {
  .glass-panel { background: color-mix(in oklab,var(--card) 65%,transparent); }
}

.glass-panel { backdrop-filter: blur(20px); box-shadow: var(--shadow-soft); padding: 24px; }

.primary-kpi { grid-template-columns: 1fr 1fr; align-items: center; gap: 24px; min-height: 200px; display: grid; position: relative; }

.eyebrow { font-family: var(--font-mono); text-transform: uppercase; color: var(--muted-foreground); font-size: 10px; }

.primary-value { font-style: ; font-variant-ligatures: ; font-variant-caps: ; font-variant-east-asian: ; font-variant-alternates: ; font-variant-position: ; font-variant-emoji: ; font-weight: ; font-stretch: ; font-size: ; line-height: ; font-family: ; font-optical-sizing: ; font-size-adjust: ; font-kerning: ; font-feature-settings: ; font-variation-settings: ; font-language-override: ; font-variant-numeric: tabular-nums; margin-top: 10px; }

.kpi-grid { grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 16px; margin-top: 16px; display: grid; }

.kpi-small { border-radius: 14px; padding: 20px; }

.kpi-value { font-style: ; font-variant-ligatures: ; font-variant-caps: ; font-variant-east-asian: ; font-variant-alternates: ; font-variant-position: ; font-variant-emoji: ; font-weight: ; font-stretch: ; font-size: ; line-height: ; font-family: ; font-optical-sizing: ; font-size-adjust: ; font-kerning: ; font-feature-settings: ; font-variation-settings: ; font-language-override: ; font-variant-numeric: tabular-nums; margin-top: 8px; }

.kpi-detail { color: var(--muted-foreground); margin-top: 4px; font-size: 11px; }

.chart-grid { grid-template-columns: 1.15fr 1fr; gap: 16px; margin-top: 24px; display: grid; }

.panel-title { justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 18px; display: flex; }

.panel-title h2 { font-size: 15px; font-weight: 600; }

.panel-title span { font-family: var(--font-mono); color: var(--muted-foreground); font-size: 10px; }

.chart-frame { min-width: 0px; height: 250px; }

.chart-frame.small { height: 125px; }

.quarter-grid { grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 12px; display: grid; }

.quarter { border-top: 3px solid var(--primary); text-align: center; padding: 14px 4px; }

.quarter strong { font-family: var(--font-display); margin-top: 8px; font-size: 20px; display: block; }

.about-strip { border-top: 1px solid var(--border); justify-content: space-between; align-items: center; gap: 24px; margin-top: 24px; padding-top: 24px; display: flex; }

.about-strip p { max-width: 700px; color: var(--muted-foreground); font-size: 12px; line-height: 1.8; }

.site-footer { border-top: 1px solid var(--border); background: var(--card); }

@supports (color: color-mix(in lab, red, red)) {
  .site-footer { background: color-mix(in oklab,var(--card) 65%,transparent); }
}

.footer-inner { justify-content: space-between; align-items: center; gap: 20px; padding-top: 22px; padding-bottom: 22px; display: flex; }

.socials { grid-template-columns: repeat(4, auto); gap: 10px; display: grid; }

.social-link { border: 1px solid var(--border); background: var(--card); border-radius: 10px; align-items: center; gap: 8px; padding: 9px 12px; font-size: 12px; display: flex; }

.social-link:hover { border-color: var(--primary); color: var(--primary); }

.positive { color: var(--primary); }

.negative { color: var(--warn); }

.doc-section { border-bottom: 1px solid var(--border); padding: 24px 0px; }

.doc-section h2 { margin-bottom: 12px; font-size: 20px; font-weight: 600; }

.doc-section p, .doc-section li { color: var(--muted-foreground); font-size: 14px; line-height: 1.9; }

.doc-section ul { padding-left: 20px; list-style: outside; }

.method-grid { grid-template-columns: repeat(3, 1fr); gap: 30px; display: grid; }

.method-number { font: 500 12px var(--font-mono); color: var(--primary); margin-bottom: 10px; }

.download-row { border-bottom: 1px solid var(--border); justify-content: space-between; align-items: center; gap: 12px; padding: 16px 0px; display: flex; }

.data-table { border-collapse: collapse; width: 100%; font-size: 12px; }

.data-table th { text-align: left; color: var(--muted-foreground); background: var(--secondary); white-space: nowrap; font-weight: 500; }

.data-table td, .data-table th { border-bottom: 1px solid var(--border); padding: 13px 16px; }

.data-table td { white-space: nowrap; }

.data-table tbody tr:hover { background: var(--accent); }

.data-table .numeric { text-align: right; font-variant-numeric: tabular-nums; }

.table-wrap { border: 1px solid var(--border); background: var(--card); border-radius: 14px; overflow-x: auto; }

.search-input { background: var(--card); border: 1px solid var(--border); border-radius: 10px; width: 100%; height: 38px; padding: 0px 12px 0px 36px; font-size: 12px; }

.recharts-default-tooltip { box-shadow: var(--shadow-soft); border-radius: 10px; font-size: 12px; }

.empty { text-align: center; color: var(--muted-foreground); padding: 50px 12px; }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.enter { animation: 0.45s ease-out 0s 1 normal both running rise; }

@media (width <= 700px) {
  .header-inner, .workspace, .footer-inner { padding-left: 16px; padding-right: 16px; }
  .header-top { height: 66px; }
  .nav-link { padding: 8px 12px; font-size: 12px; }
  .nav-link svg { display: none; }
  .workspace { padding-top: 22px; }
  .page-heading h1 { font-size: 24px; }
  .page-heading p { font-size: 11px; }
  .page-heading { align-items: flex-start; }
  .glass-panel { padding: 16px; }
  .primary-kpi { min-height: 0px; display: block; }
  .primary-value { font-size: 30px; }
  .chart-frame.small { height: 68px; margin-top: 14px; }
  .kpi-grid { gap: 8px; margin-top: 12px; }
  .kpi-small { padding: 12px; }
  .kpi-value { white-space: nowrap; font-size: 17px; }
  .kpi-detail, .eyebrow { font-size: 9px; }
  .chart-grid { grid-template-columns: 1fr; gap: 12px; margin-top: 16px; }
  .filter-select { flex: 1 1 0%; width: 30%; min-width: 0px; padding-left: 9px; }
  .filters { gap: 8px; }
  .quarter-grid { gap: 6px; }
  .quarter strong { font-size: 14px; }
  .about-strip { display: block; }
  .about-strip a { margin-top: 8px; }
  .footer-inner { display: block; }
  .socials { grid-template-columns: 1fr 1fr; margin-top: 14px; }
  .method-grid { grid-template-columns: 1fr; gap: 20px; }
  .hide-mobile { display: none; }
  .panel-title h2 { font-size: 14px; }
  .chart-frame { height: 240px; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { transition: none !important; animation: auto ease 0s 1 normal none running none !important; }
}

.header-top img { background: var(--primary); object-fit: contain; border-radius: 4px; max-width: 54px; height: 26px; padding: 3px; }

@media (width <= 700px) {
  .filters .filter-select { flex: 1 1 calc(33.333% - 6px); width: calc(33.333% - 6px); max-width: 100%; padding-right: 10px; font-size: 10px; }
  .filters > button { margin-left: 0px; }
  .filters > span { font-size: 9px; }
  .kpi-value { font-size: 15px; }
  .kpi-small { padding: 12px 10px; }
  .nav { scroll-padding-inline: 16px; }
}

