.ProseMirror p { padding: var(--prosemirror-p-pad-y,.5rem) var(--prosemirror-p-pad-x,.5rem); margin: 0px; }

.ProseMirror .file-mention-wrapper { display: inline; }

.ProseMirror .file-mention-wrapper::after { content: "â€‹"; }

.ProseMirror .chat-input-link { color: var(--fg-accent); }

.ProseMirror .chat-input-link-icon { color: var(--fg-accent); pointer-events: none; padding-left: 1.25rem; position: relative; }

.ProseMirror .chat-input-link-icon > svg { position: absolute; top: 50%; left: 0px; translate: 0px -50%; }

.tippy-box[data-theme~="suggestion"] { box-shadow: none; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

.tippy-box[data-theme~="suggestion"] > .tippy-content { padding: 0px; }

.tippy-box[data-theme~="suggestion"] > .tippy-arrow { display: none; }

