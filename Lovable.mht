.tippy-box[data-animation="fade"][data-state="hidden"] { opacity: 0; }

[data-tippy-root] { max-width: calc(-10px + 100vw); }

.tippy-box { color: rgb(255, 255, 255); white-space: normal; background-color: rgb(51, 51, 51); border-radius: 4px; outline: 0px; font-size: 14px; line-height: 1.4; transition-property: transform, visibility, opacity; position: relative; }

.tippy-box[data-placement^="top"] > .tippy-arrow { bottom: 0px; }

.tippy-box[data-placement^="top"] > .tippy-arrow::before { border-width: 8px 8px 0px; border-top-color: initial; transform-origin: center top; bottom: -7px; left: 0px; }

.tippy-box[data-placement^="bottom"] > .tippy-arrow { top: 0px; }

.tippy-box[data-placement^="bottom"] > .tippy-arrow::before { border-width: 0px 8px 8px; border-bottom-color: initial; transform-origin: center bottom; top: -7px; left: 0px; }

.tippy-box[data-placement^="left"] > .tippy-arrow { right: 0px; }

.tippy-box[data-placement^="left"] > .tippy-arrow::before { border-width: 8px 0px 8px 8px; border-left-color: initial; transform-origin: 0px center; right: -7px; }

.tippy-box[data-placement^="right"] > .tippy-arrow { left: 0px; }

.tippy-box[data-placement^="right"] > .tippy-arrow::before { border-width: 8px 8px 8px 0px; border-right-color: initial; transform-origin: 100% center; left: -7px; }

.tippy-box[data-inertia][data-state="visible"] { transition-timing-function: cubic-bezier(0.54, 1.5, 0.38, 1.11); }

.tippy-arrow { color: rgb(51, 51, 51); width: 16px; height: 16px; }

.tippy-arrow::before { content: ""; border-style: solid; border-color: rgba(0, 0, 0, 0); position: absolute; }

.tippy-content { z-index: 1; padding: 5px 9px; position: relative; }

:root { --border-default: 1px; }

@media (-webkit-device-pixel-ratio >= 2), (resolution >= 2x) {
  :root { --border-default: .5px; }
}

:root { --dialog-viewport-inset: 1.5rem; }

