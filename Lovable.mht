@keyframes shimmer-gradient { 
  0% { background-position: 200% 0px; }
  100% { background-position: 0px 0px; }
}

@keyframes heartbeat { 
  0% { transform: scale(1); }
  10% { transform: scale(1.07); }
  20% { transform: scale(1.02); }
  40% { transform: scale(1.02); }
  50% { transform: scale(1.06); }
  60% { transform: scale(1); }
}

@keyframes heart-shimmer-sweep { 
  0% { mask-position: 200% 0px; }
  100% { mask-position: -100% 0px; }
}

@keyframes shake { 
  0%, 100% { transform: translate(0px); }
  10%, 30%, 50%, 70%, 90% { transform: translate(-2px); }
  20%, 40%, 60%, 80% { transform: translate(2px); }
}

@keyframes animate-blink { 
  0%, 45% { opacity: 1; }
  50%, 95% { opacity: 0; }
  100% { opacity: 1; }
}

.animate-blink { animation: 2s ease-in-out 0s infinite normal none running animate-blink; }

@keyframes gradient-sweep { 
  0% { filter: blur(1px); background-position: 100% 0px; }
  100% { filter: blur(); background-position: 0px 0px; }
}

.gradient-text-animate { animation-name: gradient-sweep; animation-timing-function: var(--ease-in-out-quad); animation-fill-mode: forwards; }

@media (prefers-reduced-motion: reduce) {
  .gradient-text-sweep { filter: blur(); animation: auto ease 0s 1 normal none running none; background-position: 0px 0px !important; }
}

@keyframes message-highlight { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

